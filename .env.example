# ---- Apify (review data provider) ----
# Get your token at https://console.apify.com/account/integrations
# Uses actors: compass/google-maps-reviews-scraper + apify/facebook-reviews-scraper
APIFY_TOKEN=

# ---- Cache store (Upstash Redis / Vercel KV) ----
# When you add the Upstash (or Vercel KV) integration on Vercel these two
# are injected automatically. Locally, leave them blank to use a filesystem
# cache under .cache/ instead — no Redis needed for `npm run dev`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Cron protection ----
# A random secret. Vercel Cron sends it as `Authorization: Bearer <secret>`.
# Generate one: `openssl rand -hex 32`
CRON_SECRET=

# ---- Admin dashboard password ----
# Protects /admin and the admin API. Blank = open (fine for local dev only).
# ALWAYS set this before deploying.
ADMIN_PASSWORD=

# ---- Max reviews stored & fetched per location ----
# Caps cost: Apify bills per review scraped. 30 x 100 locations = 3,000 reviews
# on the first pull — well within Apify's free $5/mo credit (~8,333 reviews).
# Refreshes are incremental (only new reviews since last time) = near-zero.
REVIEWS_LIMIT=30
